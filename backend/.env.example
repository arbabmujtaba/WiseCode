# Copy to .env and fill in. Only the first block is required to start the server.

# --- Required ---
DB_CONNECT_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wisecode?retryWrites=true&w=majority
JWT_KEY=<random 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
REDIS_HOST=<redis host>
REDIS_PORT=<redis port>
REDIS_PASS=<redis password>

# --- Code execution (Run / Submit / creating problems) ---
JUDGE0_KEY=<rapidapi judge0-ce key>

# --- AI tutor (text + voice) ---
GEMINI_KEY=<google ai studio key>
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_FALLBACK_MODEL=gemini-2.5-flash-native-audio-latest
# VOICE_MAX_MINUTES=15

# --- Video editorials ---
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>

# --- Server ---
PORT=3000
# FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# NODE_ENV=production
# COOKIE_SAMESITE=lax
# REDIS_USERNAME=default

# --- Seed script (npm run seed:users) ---
# TEST_USER_EMAIL=test@wisecode.dev
# TEST_USER_PASSWORD=Test@12345
# TEST_ADMIN_EMAIL=admin@wisecode.dev
# TEST_ADMIN_PASSWORD=Admin@12345
